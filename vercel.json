{
  "functions": {
    "api/wati-webhook.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/push-send", "destination": "/api/push?action=send" },
    { "source": "/api/push-subscribe", "destination": "/api/push?action=subscribe" },
    { "source": "/api/task-reminders", "destination": "/api/wati-webhook?action=task-reminders" },
    { "source": "/iclock/:path*", "destination": "/api/pointage-api?iclock=:path*" }
  ],
  "crons": [
    { "path": "/api/task-reminders", "schedule": "0 7 * * *" },
    { "path": "/api/sync-etiquettes", "schedule": "0 6 * * *" }
  ]
}
